# Template. Copy to app/.env.local and fill in - .env.local is untracked and
# differs per machine and per environment.
#
#   cp app/.env.example app/.env.local
#
# Root of the Order Ops REST namespace, with NO trailing slash. The app appends
# /orders, /meta, /token and so on to it.
#
# Staging (use this for development):
#   VITE_API_BASE=https://staging.cartmixbd.com/wp-json/aioc/v1
#
# Live - the plugin there is still 4.9 and has no aioc/v1 routes at all, so
# this will 404 until live is upgraded. Do not point at it casually; the app
# writes real orders.
#   VITE_API_BASE=https://cartmixbd.com/wp-json/aioc/v1
#
# Whichever host this names must also have its App Origin setting (Order Ops
# -> Settings) set to the origin the app is served from, or every request
# fails CORS. For `npm run dev` that is http://localhost:5173.
VITE_API_BASE=https://staging.cartmixbd.com/wp-json/aioc/v1
